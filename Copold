<style>
:root{
--bg:#1a1a2e;--panel:#16213e;--p2:#0f3460;
--acc:#e94560;--acc2:#f5a623;--txt:#eaeaea;
--mut:#8888aa;--btn:#1e2a4a;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{
height:100%;overflow:hidden;background:var(--bg);
color:var(--txt);font-family:'Segoe UI',sans-serif
}
body{display:flex;flex-direction:column}

#r1{
height:46px;min-height:46px;background:var(--panel);
border-bottom:1px solid #252545;display:flex;align-items:center;
overflow-x:auto;overflow-y:hidden;scrollbar-width:none;flex-shrink:0
}
#r1::-webkit-scrollbar{display:none}
#r1i{display:flex;align-items:center;gap:3px;padding:0 5px;min-width:max-content}

#r2{
min-height:48px;background:#0d1829;border-bottom:1px solid #252545;
flex-shrink:0;overflow:hidden;transition:max-height .3s
}
#r2.open{max-height:220px}
#r2:not(.open){max-height:48px}
#r2h{display:flex;align-items:center;height:48px}
#r2s{flex:1;overflow-x:auto;height:48px;scrollbar-width:none}
#r2s::-webkit-scrollbar{display:none}
#pal{display:flex;align-items:center;gap:5px;padding:0 8px;min-width:max-content;height:48px}
#r2.open #r2s{height:auto;max-height:172px;overflow-x:hidden;overflow-y:auto}
#r2.open #pal{flex-wrap:wrap;min-width:unset;height:auto;padding:8px}

#r3{
height:46px;min-height:46px;background:#0a1020;
border-bottom:1px solid #252545;display:flex;align-items:center;
overflow-x:auto;scrollbar-width:none;gap:5px;padding:0 8px;flex-shrink:0
}
#r3::-webkit-scrollbar{display:none}
#r3>*{flex-shrink:0}
.opts{display:none;gap:5px;align-items:center}
.opts.on{display:flex}

#cw{
flex:1;overflow:auto;display:flex;align-items:center;justify-content:center;
background-image:repeating-conic-gradient(#1e2a3a 0% 25%,#0d1620 0% 50%);
background-size:20px 20px;
padding:5px;
touch-action:none
}

canvas{
cursor:crosshair;display:block;
box-shadow:0 0 30px #0009;
max-width:100%;max-height:100%;
object-fit:contain;
background:#fff;
touch-action:none
}

#st{
height:20px;background:var(--panel);border-top:1px solid #252545;
display:flex;align-items:center;gap:12px;padding:0 10px;
font-size:10px;color:var(--mut);flex-shrink:0
}

.b{
background:var(--btn);border:1px solid #2a3a6a;color:var(--txt);
border-radius:7px;padding:4px 7px;font-size:10px;cursor:pointer;
display:flex;flex-direction:column;align-items:center;gap:1px;
min-width:38px;user-select:none;flex-shrink:0;
touch-action:manipulation;white-space:nowrap
}
.b .i{font-size:15px;line-height:1}
.b:active,.b.on{background:var(--acc);border-color:var(--acc)}
.sep{width:1px;height:28px;background:#2a3a6a;margin:0 2px;flex-shrink:0}

.sw{
width:28px;height:28px;border-radius:50%;
border:2px solid #ffffff44;cursor:pointer;flex-shrink:0;
display:inline-block;transition:transform .1s
}
.sw.sel,.sw:active{
outline:3px solid #fff;outline-offset:1px;transform:scale(1.15)
}

input[type=color].cp{
width:30px;height:30px;padding:0;border:2px solid #ffffff44;
border-radius:50%;cursor:pointer;flex-shrink:0;background:none
}
input[type=range]{width:80px;accent-color:var(--acc)}
select.mn{
background:var(--btn);border:1px solid #2a3a6a;border-radius:6px;
color:var(--txt);padding:3px 5px;font-size:10px
}
.ni{
background:var(--btn);border:1px solid #2a3a6a;border-radius:5px;
color:var(--txt);padding:2px 5px;font-size:11px;width:44px
}
.lb{font-size:10px;color:var(--mut);white-space:nowrap}

#expB{
background:#1a2840;border:none;border-left:1px solid #252545;
color:var(--acc2);font-size:18px;width:38px;height:48px;
cursor:pointer;flex-shrink:0
}

.mo{
display:none;position:fixed;inset:0;background:#000a;z-index:300;
align-items:center;justify-content:center
}
.mo.sh{display:flex}
.mb{
background:var(--panel);border-radius:12px;padding:18px;min-width:260px;
max-width:90vw;border:1px solid #2a3a6a;max-height:90vh;overflow-y:auto
}
.mb h3{color:var(--acc2);margin-bottom:10px;font-size:14px}
.mb label{font-size:11px;color:var(--mut);display:block;margin:5px 0 2px}
.mb input,.mb select{
width:100%;background:#0d1829;border:1px solid #2a3a6a;
border-radius:6px;color:var(--txt);padding:5px 7px;font-size:12px
}
.mbs{display:flex;gap:8px;margin-top:12px}
.mbs button{flex:1;padding:8px;border-radius:7px;border:none;cursor:pointer;font-size:12px}
.bok{background:var(--acc);color:#fff}
.bno{background:var(--btn);color:var(--txt)}

#tov{
display:none;position:fixed;inset:0;z-index:400;background:#000a;
align-items:flex-end;justify-content:center
}
#tov.sh{display:flex}
#tpn{
background:#0d1829;border-radius:12px 12px 0 0;padding:12px;
width:100%;max-width:600px
}
#tpn textarea{
width:100%;background:#0a1020;border:1px solid #2a3a6a;
border-radius:8px;color:#fff;padding:8px;font-size:16px;
min-height:80px;resize:none
}
#tpn .tr{
display:flex;gap:5px;margin-top:8px;flex-wrap:wrap;align-items:center
}
</style>
</head>

