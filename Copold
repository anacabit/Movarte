<script>
/* =========================================================
   ESTADO
========================================================= */

const cv=document.getElementById('cv');
const ctx=cv.getContext('2d',{willReadFrequently:true});

let tool='pen';
let color='#000000';
let bsz=8;
let bop=1;
let btype='round';

let drawing=false;
let sx=0,sy=0,lx=0,ly=0;

let undoStk=[];
let transBg=false;

let textDir='h';
let shapeMode=null;
let hPts=[];
let hSnap=null;
let pendingText=false;
let previewSnap=null;


/* =========================================================
   CANVAS
========================================================= */

function initCv(w,h){

if(!w||!h){
const area=document.getElementById('cw');
w=Math.max(300,area.clientWidth-10);
h=Math.max(300,area.clientHeight-10);
}

if(w<100)w=794;
if(h<100)h=1123;

cv.width=w;
cv.height=h;

ctx.clearRect(0,0,w,h);

ctx.fillStyle='#ffffff';
ctx.fillRect(0,0,w,h);

document.getElementById('sSz').textContent=`${w}×${h}`;

undoStk=[];
saveU();

requestAnimationFrame(fitCanvas);
}


/* =========================================================
   AJUSTE VISUAL DEL CANVAS
========================================================= */

function fitCanvas(){

const area=document.getElementById('cw');

const aw=Math.max(50,area.clientWidth-10);
const ah=Math.max(50,area.clientHeight-10);

const scale=Math.min(aw/cv.width,ah/cv.height);

if(scale<1){
cv.style.width=Math.floor(cv.width*scale)+'px';
cv.style.height=Math.floor(cv.height*scale)+'px';
}else{
cv.style.width=cv.width+'px';
cv.style.height=cv.height+'px';
}
}


/* =========================================================
   PALETA
========================================================= */

const COLS=[
'#000000','#111111','#333333','#555555','#777777',
'#999999','#bbbbbb','#dddddd','#ffffff',
'#e94560','#c0392b','#e74c3c','#ff6b6b',
'#ff9ff3','#fd79a8','#e84393',
'#f5a623','#e67e22','#f39c12','#fdcb6e',
'#ffeaa7','#ffe066',
'#badc58','#4caf50','#27ae60','#2ecc71',
'#55efc4','#00b894','#00cec9',
'#00b4d8','#0984e3','#2980b9','#74b9ff',
'#81ecec','#a29bfe',
'#9b59b6','#8e44ad','#6c5ce7','#fd79a8','#be2edd',
'#6d4c41','#795548','#a0522d','#8d6e63','#fab1a0'
];

const palEl=document.getElementById('pal');

COLS.forEach(c=>{
const d=document.createElement('span');
d.className='sw';
d.style.background=c;
d.title=c;

d.addEventListener('pointerdown',e=>{
e.preventDefault();
setCol(c);
});

palEl.insertBefore(d,document.getElementById('cpk'));
});


function setCol(c){

color=c;

document.getElementById('cpk').value=c;
document.getElementById('cdot').style.background=c;
document.getElementById('chx').textContent=c;

document.querySelectorAll('.sw').forEach(s=>{
const sc=s.style.background;
s.classList.toggle('sel',sc===c||rgb2hex(sc)===c);
});

updB();
}


function rgb2hex(rgb){

const m=rgb.match(/\d+/g);

if(!m||m.length<3)return rgb;

return '#'+m.slice(0,3)
.map(x=>parseInt(x).toString(16).padStart(2,'0'))
.join('');
}


function addMyCol(){

const c=document.getElementById('apk').value;

const d=document.createElement('span');

d.className='sw';
d.style.background=c;
d.title=c;

d.onclick=()=>setCol(c);

palEl.insertBefore(d,document.getElementById('cpk'));
}


function togglePal(){

const r=document.getElementById('r2');

r.classList.toggle('open');

document.getElementById('expB').textContent=
r.classList.contains('open')?'▲':'▼';
}


/* =========================================================
   HERRAMIENTAS
========================================================= */

const tMap={
pen:'pen',
eraser:'pen',
line:'default',
horizon:'default',
shape:'default',
eyedrop:'default',
fill:'default',
gradient:'gradient',
rembg:'rembg'
};

function showOpts(t){

document.querySelectorAll('.opts')
.forEach(d=>d.classList.remove('on'));

const id='op-'+(tMap[t]||'default');
const el=document.getElementById(id);

if(el)el.classList.add('on');
}


function setT(t){

tool=t;
shapeMode=null;

document.querySelectorAll('#r1i .b')
.forEach(b=>b.classList.remove('on'));

const m={
pen:'bPen',
eraser:'bErase',
fill:'bFill',
gradient:'bGrad',
line:'bLine',
horizon:'bMtn',
eyedrop:'bEye',
rembg:'bRem'
};

if(m[t])document.getElementById(m[t]).classList.add('on');

document.getElementById('sTl').textContent=t;

hPts=[];
hSnap=null;
previewSnap=null;

cv.style.cursor=
['eyedrop','fill','rembg'].includes(t)
?'cell':'crosshair';

showOpts(t);
pendingText=false;
}


/* =========================================================
   NUEVO SISTEMA DE FIGURAS
========================================================= */

function setShape(s){

shapeMode=s;
tool='shape';

document.querySelectorAll('#r1i .b')
.forEach(b=>b.classList.remove('on'));

document.getElementById('sTl').textContent='Forma: '+s;

showOpts('shape');

placeShapeCenter(s);
}


function placeShapeCenter(s){

saveU();

let size=Math.min(cv.width,cv.height)*0.38;
size=Math.max(120,Math.min(size,430));

const cx=cv.width/2;
const cy=cv.height/2;

const x1=cx-size/2;
const y1=cy-size/2;
const x2=cx+size/2;
const y2=cy+size/2;

drawColoringShape(ctx,s,x1,y1,x2,y2);

fitCanvas();
}


function drawColoringShape(g,shape,x1,y1,x2,y2){

const w=x2-x1;
const h=y2-y1;
const mx=(x1+x2)/2;
const my=(y1+y2)/2;

const r=Math.min(Math.abs(w),Math.abs(h))/2;

g.save();

g.globalAlpha=1;
g.fillStyle='#ffffff';
g.strokeStyle='#111111';
g.lineWidth=Math.max(4,Math.min(9,r*.035));
g.lineJoin='round';
g.lineCap='round';

switch(shape){

case 'circle':
g.beginPath();
g.arc(mx,my,r*.85,0,Math.PI*2);
g.fill();
g.stroke();
break;

case 'rect':
g.beginPath();
g.roundRect(x1+10,y1+10,w-20,h-20,8);
g.fill();
g.stroke();
break;

case 'triangle':
g.beginPath();
g.moveTo(mx,y1+10);
g.lineTo(x2-10,y2-10);
g.lineTo(x1+10,y2-10);
g.closePath();
g.fill();
g.stroke();
break;

case 'star':
fStar(g,mx,my,5,r*.85,r*.38);
g.fill();
g.stroke();
break;

case 'heart':
fHeart(g,mx,my,r*1.5);
g.fill();
g.stroke();
break;

case 'flower':
for(let i=0;i<8;i++){
const a=Math.PI*2*i/8;
g.beginPath();
g.ellipse(mx+Math.cos(a)*r*.48,my+Math.sin(a)*r*.48,r*.28,r*.46,a,0,Math.PI*2);
g.fill();
g.stroke();
}
g.beginPath();
g.arc(mx,my,r*.24,0,Math.PI*2);
g.fill();
g.stroke();
break;

case 'sun':
g.beginPath();
g.arc(mx,my,r*.45,0,Math.PI*2);
g.fill();
g.stroke();
for(let i=0;i<16;i++){
const a=Math.PI*2*i/16;
g.beginPath();
g.moveTo(mx+Math.cos(a)*r*.56,my+Math.sin(a)*r*.56);
g.lineTo(mx+Math.cos(a)*r*.9,my+Math.sin(a)*r*.9);
g.stroke();
}
break;

case 'moon':
g.beginPath();
g.arc(mx,my,r*.78,0,Math.PI*2);
g.fill();
g.stroke();
g.save();
g.fillStyle='#ffffff';
g.strokeStyle='#ffffff';
g.beginPath();
g.arc(mx+r*.30,my-r*.16,r*.70,0,Math.PI*2);
g.fill();
g.restore();
break;

case 'house':
drawHouse(g,x1,y1,w,h);
break;

case 'tree':
drawTree(g,mx,y1,w,h,r);
break;

case 'cloud':
drawCloud(g,mx,my,r);
break;

case 'arrow':
g.beginPath();
g.moveTo(x1+10,my-r*.18);
g.lineTo(x2-r*.25,my-r*.18);
g.lineTo(x2-r*.25,my-r*.48);
g.lineTo(x2-10,my);
g.lineTo(x2-r*.25,my+r*.48);
g.lineTo(x2-r*.25,my+r*.18);
g.lineTo(x1+10,my+r*.18);
g.closePath();
g.fill();
g.stroke();
break;

case 'butterfly':
drawButterfly(g,mx,my,r);
break;

case 'bird':
drawBird(g,mx,my,r);
break;

case 'fish':
drawFish(g,mx,my,r);
break;
}

g.restore();
}


