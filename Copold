function paintOn(g,x,y,s){
const col=tool==='eraser'?'#ffffff':color;
g.fillStyle=col;
g.strokeStyle=col;
switch(btype){
case 'round':
g.beginPath();
g.arc(x,y,s/2,0,Math.PI*2);
g.fill();
break;
case 'square':
g.fillRect(x-s/2,y-s/2,s,s);
break;
case 'circle':
g.beginPath();
g.arc(x,y,s/2,0,Math.PI*2);
g.lineWidth=Math.max(1,s*.15);
g.stroke();
break;
case 'star':
fStar(g,x,y,5,s/2,s/4);
g.fill();
break;
case 'heart':
fHeart(g,x,y,s);
g.fill();
break;
case 'diamond':
fDiamond(g,x,y,s);
g.fill();
break;
case 'leaf':
fLeaf(g,x,y,s);
g.fill();
break;
case 'spray':
fSpray(g,x,y,s);
break;
}
}


function gpos(e){
const r=cv.getBoundingClientRect();
const scaleX=cv.width/r.width;
const scaleY=cv.height/r.height;
return{x:(e.clientX-r.left)*scaleX,y:(e.clientY-r.top)*scaleY};
}


cv.addEventListener('pointerdown',e=>{
e.preventDefault();
const p=gpos(e);
onDn(p.x,p.y);
},{passive:false});


cv.addEventListener('pointermove',e=>{
e.preventDefault();
const p=gpos(e);
onMv(p.x,p.y);
document.getElementById('sPo').textContent=`X:${Math.round(p.x)} Y:${Math.round(p.y)}`;
},{passive:false});


cv.addEventListener('pointerup',e=>{
e.preventDefault();
if(drawing)onUp(gpos(e));
},{passive:false});


cv.addEventListener('pointercancel',()=>{
if(drawing)onUp({x:lx,y:ly});
});


function onDn(x,y){
sx=x;sy=y;lx=x;ly=y;
if(tool==='fill'){saveU();floodFill(~~x,~~y,color);return;}
if(tool==='eyedrop'){pickCol(~~x,~~y);return;}
if(tool==='rembg'){saveU();removeBgAt(~~x,~~y,+document.getElementById('rbt').value);return;}
if(tool==='horizon'){hPts.push({x,y});drawHPrev();return;}
if(pendingText){saveU();doStamp(x,y);pendingText=false;closeTxt();return;}
drawing=true;
if(tool==='pen'||tool==='eraser'){saveU();startStroke(x,y);}
if(tool==='line'||tool==='shape'||tool==='gradient'){saveU();previewSnap=ctx.getImageData(0,0,cv.width,cv.height);}
}


function onMv(x,y){
if(!drawing)return;
if(tool==='pen'||tool==='eraser'){contStroke(x,y);}
if((tool==='line'||tool==='shape'||tool==='gradient')&&previewSnap){
ctx.putImageData(previewSnap,0,0);
drawPreview(x,y);
}
lx=x;ly=y;
}


function onUp(p){
if(!drawing)return;
const x=p?p.x:lx;
const y=p?p.y:ly;
drawing=false;
if(tool==='line'||tool==='shape'||tool==='gradient'){
if(previewSnap)ctx.putImageData(previewSnap,0,0);
drawFinal(x,y);
previewSnap=null;
}
}


function startStroke(x,y){
ctx.globalAlpha=bop;
const col=tool==='eraser'?'#ffffff':color;
ctx.strokeStyle=col;ctx.fillStyle=col;
ctx.lineCap='round';ctx.lineJoin='round';ctx.lineWidth=bsz;
if(btype==='round'){ctx.beginPath();ctx.moveTo(x,y);}
paintAt(x,y);
}


function contStroke(x,y){
if(btype==='round'){ctx.lineTo(x,y);ctx.stroke();}
else{paintAt(x,y);}
}


function paintAt(x,y){
ctx.globalAlpha=bop;
const col=tool==='eraser'?'#ffffff':color;
ctx.fillStyle=col;ctx.strokeStyle=col;
paintOn(ctx,x,y,bsz);
}


function drawPreview(x,y){
ctx.globalAlpha=bop;ctx.lineWidth=bsz;ctx.lineCap='round';
ctx.fillStyle=color;ctx.strokeStyle=color;
if(tool==='line'){ctx.beginPath();ctx.moveTo(sx,sy);ctx.lineTo(x,y);ctx.stroke();}
else if(tool==='shape'){drawColoringShape(ctx,shapeMode,sx,sy,x,y);}
else if(tool==='gradient'){ctx.fillStyle=mkGrad(sx,sy,x,y);ctx.fillRect(Math.min(sx,x),Math.min(sy,y),Math.abs(x-sx),Math.abs(y-sy));}
}


function drawFinal(x,y){
ctx.globalAlpha=bop;ctx.lineWidth=bsz;ctx.lineCap='round';
ctx.fillStyle=color;ctx.strokeStyle=color;
if(tool==='line'){ctx.beginPath();ctx.moveTo(sx,sy);ctx.lineTo(x,y);ctx.stroke();}
else if(tool==='shape'){drawColoringShape(ctx,shapeMode,sx,sy,x,y);}
else if(tool==='gradient'){ctx.fillStyle=mkGrad(sx,sy,x,y);ctx.fillRect(Math.min(sx,x),Math.min(sy,y),Math.abs(x-sx),Math.abs(y-sy));}
}


function mkGrad(x1,y1,x2,y2){
const c1=document.getElementById('g1').value;
const c2=document.getElementById('g2').value;
const c3=document.getElementById('g3').value;
const dir=document.getElementById('gd').value;
let g;
if(dir==='radial'){
const mx=(x1+x2)/2;const my=(y1+y2)/2;const r=Math.hypot(x2-x1,y2-y1)/2;
g=ctx.createRadialGradient(mx,my,0,mx,my,r);
}else if(dir==='lr'){
g=ctx.createLinearGradient(Math.min(x1,x2),0,Math.max(x1,x2),0);
}else if(dir==='tb'){
g=ctx.createLinearGradient(0,Math.min(y1,y2),0,Math.max(y1,y2));
}else{
g=ctx.createLinearGradient(x1,y1,x2,y2);
}
g.addColorStop(0,c1);g.addColorStop(.5,c2);g.addColorStop(1,c3);
return g;
}


function drawHPrev(){
if(!hSnap)hSnap=ctx.getImageData(0,0,cv.width,cv.height);
ctx.putImageData(hSnap,0,0);
ctx.globalAlpha=bop;ctx.strokeStyle=color;ctx.lineWidth=bsz;ctx.lineCap='round';
ctx.beginPath();
hPts.forEach((p,i)=>{if(i===0)ctx.moveTo(p.x,p.y);else ctx.lineTo(p.x,p.y);});
ctx.stroke();
}


document.addEventListener('dblclick',()=>{
if(tool==='horizon'&&hPts.length>1){
ctx.putImageData(hSnap,0,0);
ctx.globalAlpha=bop;ctx.strokeStyle=color;ctx.lineWidth=bsz;ctx.lineCap='round';
ctx.beginPath();
hPts.forEach((p,i)=>{if(i===0)ctx.moveTo(p.x,p.y);else ctx.lineTo(p.x,p.y);});
ctx.stroke();
hPts=[];hSnap=null;saveU();
}
});


function floodFill(px,py,fc){
if(px<0||py<0||px>=cv.width||py>=cv.height)return;
const img=ctx.getImageData(0,0,cv.width,cv.height);
const d=img.data;const w=cv.width;const h=cv.height;
const id=(x,y)=>(y*w+x)*4;
const ti=id(px,py);
const tr=d[ti];const tg=d[ti+1];const tb=d[ti+2];const ta=d[ti+3];
const[fr,fg,fb]=h2r(fc);
if(tr===fr&&tg===fg&&tb===fb)return;
const stk=[[px,py]];const vis=new Uint8Array(w*h);
while(stk.length){
const[x,y]=stk.pop();
if(x<0||x>=w||y<0||y>=h)continue;
const i=id(x,y);const vi=y*w+x;
if(vis[vi])continue;
if(!mCol(d,i,tr,tg,tb,ta))continue;
vis[vi]=1;d[i]=fr;d[i+1]=fg;d[i+2]=fb;d[i+3]=255;
stk.push([x+1,y],[x-1,y],[x,y+1],[x,y-1]);
}
ctx.putImageData(img,0,0);
}


function mCol(d,i,r,g,b,a,t=30){
return(Math.abs(d[i]-r)<t&&Math.abs(d[i+1]-g)<t&&Math.abs(d[i+2]-b)<t&&Math.abs(d[i+3]-a)<t);
}


function h2r(h){
return[parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)];
}


function pickCol(x,y){
const p=ctx.getImageData(x,y,1,1).data;
setCol('#'+[p[0],p[1],p[2]].map(v=>v.toString(16).padStart(2,'0')).join(''));
}


function removeBgAt(px,py,thresh){
const img=ctx.getImageData(0,0,cv.width,cv.height);
const d=img.data;const w=cv.width;const h=cv.height;
const id=(x,y)=>(y*w+x)*4;
const ti=id(px,py);
const tr=d[ti];const tg=d[ti+1];const tb=d[ti+2];const ta=d[ti+3];
const stk=[[px,py]];const vis=new Uint8Array(w*h);
while(stk.length){
const[x,y]=stk.pop();
if(x<0||x>=w||y<0||y>=h)continue;
const i=id(x,y);const vi=y*w+x;
if(vis[vi])continue;
if(!mCol(d,i,tr,tg,tb,ta,thresh))continue;
vis[vi]=1;d[i+3]=0;
stk.push([x+1,y],[x-1,y],[x,y+1],[x,y-1]);
}
ctx.putImageData(img,0,0);
transBg=true;
}


function openTxt(){
document.getElementById('tov').classList.add('sh');
setTimeout(()=>{document.getElementById('ta').focus();},100);
}


function closeTxt(){
document.getElementById('tov').classList.remove('sh');
pendingText=false;cv.style.cursor='crosshair';
}


function setTD(d){
textDir=d;
['tdH','tdV','tdD'].forEach(id=>document.getElementById(id).classList.remove('on'));
document.getElementById(d==='h'?'tdH':d==='v'?'tdV':'tdD').classList.add('on');
}


function stampTxt(){
document.getElementById('tov').classList.remove('sh');
pendingText=true;cv.style.cursor='text';
}


function doStamp(x,y){
const txt=document.getElementById('ta').value||'Texto';
const sz=+document.getElementById('tsz').value||36;
const ff=document.getElementById('tft').value;
const useGr=document.getElementById('tgr').checked;
ctx.save();
ctx.font=`bold ${sz}px "${ff}"`;ctx.textBaseline='top';ctx.globalAlpha=bop;
ctx.translate(x,y);
if(textDir==='v')ctx.rotate(Math.PI/2);
else if(textDir==='d')ctx.rotate(Math.PI/4);
if(useGr){
const gr=ctx.createLinearGradient(0,0,txt.length*sz*.6,sz);
gr.addColorStop(0,document.getElementById('g1').value);
gr.addColorStop(.5,document.getElementById('g2').value);
gr.addColorStop(1,document.getElementById('g3').value);
ctx.fillStyle=gr;
}else{
ctx.fillStyle=document.getElementById('tcol').value;
}
ctx.fillText(txt,0,0);
ctx.restore();
pendingText=false;cv.style.cursor='crosshair';
}


