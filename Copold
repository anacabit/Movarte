const img=new Image();
img.onload=()=>{saveU();ctx.drawImage(img,0,0,cv.width,cv.height);inp.value='';};
img.src=URL.createObjectURL(f);
}


function apBg(){
transBg=false;
const c=document.getElementById('bgc').value;
const img=ctx.getImageData(0,0,cv.width,cv.height);
ctx.fillStyle=c;ctx.fillRect(0,0,cv.width,cv.height);
ctx.putImageData(img,0,0);
hideMo('mBg');
}


function apTr(){
transBg=true;
const img=ctx.getImageData(0,0,cv.width,cv.height);
ctx.clearRect(0,0,cv.width,cv.height);
ctx.putImageData(img,0,0);
hideMo('mBg');
}


function saveU(){
if(!cv.width||!cv.height)return;
if(undoStk.length>40)undoStk.shift();
undoStk.push(ctx.getImageData(0,0,cv.width,cv.height));
}


function undo(){
if(undoStk.length<2)return;
undoStk.pop();
ctx.putImageData(undoStk[undoStk.length-1],0,0);
}


function clearAll(){
saveU();
ctx.clearRect(0,0,cv.width,cv.height);
if(!transBg){
ctx.fillStyle=document.getElementById('bgc').value||'#fff';
ctx.fillRect(0,0,cv.width,cv.height);
}
}


function doSave(){
const fmt=document.getElementById('sfmt').value;
const q=+document.getElementById('jpgq').value/100;
if(fmt==='pdf'){savePDF();return;}
if(fmt==='jpg'){
const tmp=document.createElement('canvas');
tmp.width=cv.width;tmp.height=cv.height;
const tc=tmp.getContext('2d');
tc.fillStyle='#fff';tc.fillRect(0,0,tmp.width,tmp.height);
tc.drawImage(cv,0,0);
dl(tmp.toDataURL('image/jpeg',q),'acas-dibujo.jpg');
}else{
dl(cv.toDataURL('image/png'),'acas-dibujo.png');
}
hideMo('mSv');
}


function dl(url,name){
const a=document.createElement('a');
a.href=url;a.download=name;
document.body.appendChild(a);a.click();a.remove();
}


function savePDF(){
const s=document.createElement('script');
s.src='https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
s.onload=()=>{
const{jsPDF}=window.jspdf;
const pdf=new jsPDF({
orientation:cv.width>cv.height?'landscape':'portrait',
unit:'px',format:[cv.width,cv.height]
});
pdf.addImage(cv.toDataURL('image/png'),'PNG',0,0,cv.width,cv.height);
pdf.save('acas-dibujo.pdf');
hideMo('mSv');
};
document.head.appendChild(s);
}


function showMo(id){document.getElementById(id).classList.add('sh');}
function hideMo(id){document.getElementById(id).classList.remove('sh');}


function apPre(){
const v=document.getElementById('pp').value;
if(!v)return;
const[w,h]=v.split(',');
document.getElementById('cw2').value=w;
document.getElementById('ch2').value=h;
}


function apSz(){
const w=+document.getElementById('cw2').value||794;
const h=+document.getElementById('ch2').value||1123;
initCv(w,h);
hideMo('mSz');
}


window.addEventListener('load',()=>{
setTimeout(()=>{
initCv(794,1123);
updB();
setCol('#000000');
fitCanvas();

/* ── PWA: registrar Service Worker ── */
if('serviceWorker' in navigator){
navigator.serviceWorker.register('./sw.js')
.catch(e=>console.warn('SW:',e));
}

},50);
});


window.addEventListener('resize',fitCanvas);

</script>

